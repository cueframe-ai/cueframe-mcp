{
  "name": "cueframe",
  "version": "0.9.1",
  "description": "CueFrame video editing CLI: manage media, edit compositions and render MP4s from terminals and scripts.",
  "keywords": [
    "cueframe",
    "video-editing",
    "video-rendering",
    "composition",
    "cli",
    "automation",
    "mcp"
  ],
  "homepage": "https://cueframe.ai/cli",
  "author": "CueFrame, Inc.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "cueframe": "dist/cueframe.js"
  },
  "main": "dist/cueframe.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "add-mcp": "^2.4.0",
    "better-auth": "1.6.22",
    "commander": "^13.1.0",
    "open": "^10.1.0",
    "ora": "^9.4.1",
    "pino": "^10.3.1"
  },
  "scripts": {
    "build": "tsup && node scripts/copy-agent-skills.mjs && node scripts/check-bundle-free-of-kernel.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "check:bundle": "node scripts/check-bundle-free-of-kernel.mjs"
  },
  "devDependencies": {
    "@cueframe/sdk": "workspace:^",
    "zod": "^4.5.4",
    "@types/node": "^24.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2",
    "@cueframe/skills": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cueframe-ai/cueframe-mcp.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/cueframe-ai/cueframe-mcp/issues"
  }
}
