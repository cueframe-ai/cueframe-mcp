{
  "kind": "card",
  "html": "<style>\n.cf-mounted-demo{position:relative;width:100%;height:100%;overflow:hidden;background:#e9edf5;font-family:Arial,sans-serif;color:#162033;--settle:clamp(0,calc(var(--cf-t)/var(--cf-settleSec)),1);--pose:calc(1 - (1 - var(--settle))*(1 - var(--settle))*(1 - var(--settle)));--approach:clamp(0,calc((var(--cf-t) - var(--cf-contactSec) + var(--cf-approachSec))/var(--cf-approachSec)),1);--response:clamp(0,calc((var(--cf-t) - var(--cf-contactSec))/var(--cf-responseSec)),1)}\n.cf-mounted-demo .stage{position:absolute;left:50%;top:50%;width:380px;height:720px;transform:translate(-50%,-50%);perspective:1400px}\n.cf-mounted-demo .phone{position:absolute;inset:0;border:10px solid #172032;border-radius:52px;background:#172032;box-sizing:border-box;box-shadow:18px 30px 45px #15263a30;transform:translateY(calc((1 - var(--pose))*120px)) rotateY(calc((1 - var(--pose))*var(--cf-tiltDeg)*1deg)) rotateZ(calc((1 - var(--pose))*-5deg))}\n.cf-mounted-demo .screen{position:absolute;inset:0;border-radius:40px;overflow:hidden;background:#fbfcff}\n.cf-mounted-demo .top{position:absolute;left:28px;right:28px;top:38px;font-size:24px;font-weight:700}\n.cf-mounted-demo .card{position:absolute;left:28px;right:28px;top:110px;height:182px;border-radius:18px;background:var(--cf-accent);color:white;box-shadow:0 9px 18px #16203328}\n.cf-mounted-demo .card:before{content:\"NORTH\";position:absolute;left:22px;top:24px;font-size:21px;font-weight:700;letter-spacing:3px}\n.cf-mounted-demo .holder:after{content:var(--cf-holder)}\n.cf-mounted-demo .holder{position:absolute;left:22px;bottom:24px;font-size:18px;letter-spacing:2px}\n.cf-mounted-demo .label{position:absolute;top:330px;left:28px;font-size:20px}\n.cf-mounted-demo .control{position:absolute;left:100px;top:400px;width:160px;height:70px;border:2px solid #b5bfd1;border-radius:18px;box-sizing:border-box;background:#eef2f9;display:grid;place-items:center;font-size:22px;font-weight:700}\n.cf-mounted-demo .frozen{position:absolute;inset:0;border-radius:16px;background:var(--cf-accent);color:white;display:grid;place-items:center;opacity:var(--response)}\n.cf-mounted-demo .pointer{position:absolute;left:180px;top:435px;width:36px;height:48px;background:#162033;clip-path:polygon(0 0,100% 65%,58% 68%,43% 100%);filter:drop-shadow(1px 3px 2px #15263a99);transform:translate(calc((1 - var(--approach))*95px),calc((1 - var(--approach))*80px));transform-origin:0 0}\n.cf-mounted-demo .status{position:absolute;left:28px;right:28px;top:530px;font-size:20px;line-height:1.4;opacity:var(--response)}\n</style><div class=\"cf-mounted-demo\"><div class=\"stage\"><div class=\"phone\"><div class=\"screen\"><div class=\"top\">Your card</div><div class=\"card\"><div class=\"holder\"></div></div><div class=\"label\">Card controls</div><div class=\"control\">Freeze<div class=\"frozen\">Frozen</div></div><div class=\"pointer\"></div><div class=\"status\">Payments are paused.<br>Your card is still here.</div></div></div></div></div>",
  "tokens": {
    "accent": "#4265d5",
    "holder": "\"MAYA\"",
    "settleSec": "1.0",
    "tiltDeg": "28",
    "contactSec": "2.0",
    "approachSec": "0.65",
    "responseSec": "0.2"
  }
}
