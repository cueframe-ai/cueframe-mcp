{
  "name": "@cueframe/sdk",
  "version": "0.13.3",
  "description": "TypeScript SDK for the CueFrame video editing and rendering API: media, compositions, captions and cloud render jobs.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./zod": {
      "types": "./src/zod.ts",
      "import": "./src/zod.ts"
    },
    "./client-identity": {
      "types": "./src/clientIdentity.ts",
      "import": "./src/clientIdentity.ts"
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsup",
    "prepublishOnly": "node -e \"if(!/pnpm/.test(process.env.npm_config_user_agent||0))throw new Error('publish with pnpm publish \u2014 npm ignores the publishConfig entry-point overrides and ships a broken tarball')\" && pnpm build"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.3",
    "tsup": "^8.3.5",
    "@typescript/native": "npm:typescript@^7.0.2"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./zod": {
        "types": "./dist/zod.d.ts",
        "import": "./dist/zod.js"
      },
      "./client-identity": {
        "types": "./dist/clientIdentity.d.ts",
        "import": "./dist/clientIdentity.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cueframe-ai/cueframe-mcp.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://cueframe.ai/api",
  "bugs": {
    "url": "https://github.com/cueframe-ai/cueframe-mcp/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "author": "CueFrame, Inc.",
  "keywords": [
    "cueframe",
    "video-editing",
    "video-rendering",
    "typescript",
    "sdk",
    "rest-api",
    "captions"
  ]
}
