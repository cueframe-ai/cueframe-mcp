{
  "name": "cueframe-mcp",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "license": "Apache-2.0",
  "scripts": {
    "build": "pnpm build:plugin && pnpm -r run --if-present build",
    "build:plugin": "node scripts/plugin/sync-versions.mjs && node scripts/plugin/sync-openai-yaml.mjs",
    "check": "pnpm check:api-inputs && pnpm check:contract-version && pnpm check:openapi-public && pnpm check:server-json && pnpm check:plugin && pnpm check:tool-reference && pnpm --filter @cueframe/api-contract check && pnpm -r run --if-present check",
    "check:plugin": "node scripts/plugin/validate.mjs",
    "check:tool-reference": "node scripts/generate-tool-reference.mjs --check",
    "test": "pnpm -r run --if-present test && pnpm test:tools",
    "test:tools": "node --test tools/*.test.mjs scripts/*.test.mjs scripts/plugin/*.test.mjs",
    "check:openapi-public": "node tools/check-openapi-public.mjs",
    "check:server-json": "node scripts/check-server-json.mjs",
    "generate:sdk": "pnpm --filter @cueframe/api-contract build && orval --config ./orval.config.ts && node packages/sdk/scripts/generate-barrels.mjs && node tools/normalize-generated-text.mjs",
    "check:api-inputs": "node tools/check-api-inputs.mjs",
    "check:contract-version": "node scripts/check-contract-version.mjs",
    "generate:api-consumers": "pnpm check:api-inputs && pnpm generate:sdk",
    "check:api-consumer-drift": "pnpm generate:api-consumers && git diff --exit-code -- api/openapi.json packages/sdk/src/generated",
    "spec:drift": "node tools/spec-drift.mjs",
    "build:plugin:openai": "node scripts/plugin/package-openai.mjs",
    "check:plugin:openai": "node scripts/plugin/package-openai.mjs --check",
    "check:public-packages": "node scripts/check-public-packages.mjs",
    "check:published-versions": "node scripts/check-published-versions.mjs"
  },
  "pnpm": {
    "overrides": {
      "@cueframe/kernel": "file:artifacts/cueframe-kernel-0.7.15-ea20261029.7.tgz",
      "@better-auth/sso": "1.6.22",
      "add-mcp>js-yaml": "4.3.2",
      "better-call": "1.3.7",
      "esbuild": "0.28.2"
    }
  },
  "devDependencies": {
    "@orval/zod": "8.41.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "orval": "8.41.0",
    "yaml": "^2.8.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
