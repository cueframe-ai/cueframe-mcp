{
  "name": "cueframe",
  "version": "0.12.0",
  "description": "CueFrame video editing CLI: manage media, edit compositions and render MP4s from terminals and scripts.",
  "keywords": [
    "cueframe",
    "video-editing",
    "video-rendering",
    "composition",
    "cli",
    "automation",
    "mcp"
  ],
  "homepage": "https://cueframe.ai/cli",
  "author": "CueFrame, Inc.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "cueframe": "dist/cueframe.js"
  },
  "main": "dist/cueframe.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "add-mcp": "^2.6.0",
    "better-auth": "1.7.14",
    "commander": "^15.0.0",
    "open": "^11.0.4",
    "ora": "^10.0.0",
    "pino": "^10.3.1"
  },
  "scripts": {
    "build": "tsup && node scripts/copy-agent-skills.mjs && node scripts/check-bundle-free-of-kernel.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "check:bundle": "node scripts/check-bundle-free-of-kernel.mjs"
  },
  "devDependencies": {
    "@cueframe/sdk": "workspace:^",
    "@cueframe/skills": "workspace:*",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "tsup": "^8.5.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.3",
    "zod": "^4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cueframe-ai/cueframe-mcp.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/cueframe-ai/cueframe-mcp/issues"
  }
}
