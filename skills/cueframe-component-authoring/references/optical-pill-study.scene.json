        "source": "float strand(vec2 q, float index, float clock) {\n  float jitter = sin(index * 12.9898 + filamentSeed * 0.73) * variation;\n  float curve = 0.12 * sin(q.x * 6.283185 + clock) + (index - 2.5) * spread + jitter;\n  float d = abs(q.y - curve);\n  float core = exp(-d * d / (coreWidth * coreWidth));\n  float fieldGlow = exp(-d * d / (falloff * falloff));\n  return coreIntensity * core + fieldIntensity * fieldGlow;\n}\nvec3 field(vec2 uv, vec3 localPosition) {\n  vec2 q = uv - vec2(0.5) - fieldOffset;\n  float clock = cfTime * clockRate + phase;\n  float bundle = strand(q, 0.0, clock) + strand(q, 1.0, clock) + strand(q, 2.0, clock) + strand(q, 3.0, clock) + strand(q, 4.0, clock) + strand(q, 5.0, clock);\n  float envelope = exp(-q.x * q.x * 3.0);\n  return vec3(0.002, 0.003, 0.008) + tint * bundle * envelope;\n}",
